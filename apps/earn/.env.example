# Server
DATABASE_URL=postgresql://user:pass@host:5432/db
PORT=3000
PUBLIC_URL=https://earn.rootnetwork.co

# Privy (https://dashboard.privy.io) — required in production
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Same app id, exposed to the client at build time
VITE_PRIVY_APP_ID=

# Local development only: accept `dev:<name>` tokens when Privy is not configured
ALLOW_DEV_AUTH=0

# Optional: pin the network trajectory's T0 (ISO date). Written once; ignored afterwards.
# NETWORK_STARTED_AT=2026-09-08T08:00:00Z
