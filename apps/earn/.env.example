# Server
DATABASE_URL=postgresql://user:pass@host:5432/db
PORT=3000
PUBLIC_URL=https://earn.rootnetwork.co
# Treasury signer. Must derive to TREASURY_ADDRESS or the payer refuses to start.
# When set, the worker sends real USDC (Base) / USDG (Robinhood Chain) transfers from the treasury.
# TREASURY_PRIVATE_KEY=0x...
# Optional RPC overrides (e.g. Alchemy) for reliability.
# BASE_RPC_URL=https://mainnet.base.org
# ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Auto-pay contributor withdrawals from the dashboard (off by default; balances come from the traffic simulation).
# PAY_USER_WITHDRAWALS=0
# Node wallets (NODE_WALLETS entries with `pk`) send payouts back via two fresh hop wallets (20–180 min, then 2× 10–90 min);
# treasury tops up node gas once, hop keys are stored encrypted under TREASURY_PRIVATE_KEY and wiped when funds are home.
# RECYCLE_PAYOUTS=1
# RECYCLE_TO=0x...   (defaults to the treasury address)
# T0 of the public curve; only applied when the curve version changes or on first boot.
# NETWORK_STARTED_AT=2026-09-08T06:00:00Z

# Published Chrome Web Store extension (CORS allow-list + install link). Add unpacked dev IDs to EXTENSION_IDS, comma separated.
EXTENSION_ID=jlgmdngjhimpgjeceddehokdjcbglebg

# Privy (https://dashboard.privy.io) — required in production
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Same app id, exposed to the client at build time
VITE_PRIVY_APP_ID=

# Local development only: accept `dev:<name>` tokens when Privy is not configured
ALLOW_DEV_AUTH=0

# Railway build hints (set as service variables): NIXPACKS_NODE_VERSION=22, NPM_CONFIG_PRODUCTION=false,
# NIXPACKS_INSTALL_CMD="npm install --no-audit --no-fund" (lockfile peer resolution differs across npm majors).

# Optional: pin the network trajectory's T0 (ISO date). Written once; ignored afterwards.
# NETWORK_STARTED_AT=2026-09-08T08:00:00Z
