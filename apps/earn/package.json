{
  "name": "@rootnetwork/earn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host --port 5175",
    "dev:server": "node --watch server/index.mjs",
    "build": "npm run build:extension && tsc --noEmit -p tsconfig.json && vite build",
    "build:extension": "node scripts/build-extension.mjs",
    "start": "node server/index.mjs"
  },
  "dependencies": {
    "@privy-io/react-auth": "^2.15.0",
    "@privy-io/server-auth": "^1.28.0",
    "archiver": "^7.0.1",
    "buffer": "^6.0.3",
    "d3-geo": "^3.1.1",
    "express": "^4.21.2",
    "framer-motion": "^11.15.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "topojson-client": "^3.1.0",
    "viem": "^2.56.3",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
